# FlipOS environment variables
# Copy to .env.local for local development. Keep local and preview/staging
# values isolated from production. Never commit .env.local or use live Stripe
# credentials for testing.

# Optional Clerk account integration. Use test keys in local/staging.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Stripe test-mode credentials and recurring test price IDs for local/staging.
# Checkout and Stripe revalidation remain unavailable until all three are set.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ANNUAL=price_...

# Server-controlled Checkout return URL override. Use the local origin for
# development; use a separate isolated preview/staging origin when applicable.
APP_URL=http://localhost:3000

# Stripe test-mode webhook signing secret. For local tests, run:
#   stripe listen --forward-to localhost:3000/api/stripe-webhook
# Subscribe the endpoint to all five events below:
#   checkout.session.completed
#   checkout.session.async_payment_succeeded
#   customer.subscription.created
#   customer.subscription.updated
#   customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional analytics-only storage. Use a separate non-production database.
# Needed for deduplicated paid-success analytics and consent-revocation markers,
# not for payment verification, entitlement grants, or Clerk plan updates.
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=
